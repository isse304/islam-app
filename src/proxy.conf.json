{
  "/api/alquran/*": {
    "target": "https://api.alquran.cloud/v1",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/alquran": ""
    },
    "logLevel": "debug"
  },
  "/api/quran/*": {
    "target": "https://api.quran.com/api/v4",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/quran": ""
    },
    "logLevel": "debug"
  },
  "/content/api": {
    "target": "https://apis-prelive.quran.foundation",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug"
  },
  "/api": {
    "target": "http://localhost:3000",
    "secure": false,
    "logLevel": "debug"
  }
}