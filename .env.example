# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
DOMAIN=localhost

# Firebase Admin (entire service account JSON on one line)
FIREBASE_CONFIG={"type":"service_account","project_id":"your_project_id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your_service_account_email"}

# Database
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=your_stripe_price_id_here

# URLs and CORS
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# Session and access control
SESSION_SECRET=your_long_random_session_secret_here
ADMIN_USERS=comma_separated_firebase_uids

# Days a lapsed subscription keeps premium access after subscriptionEnd
PREMIUM_GRACE_DAYS=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DAILY_USER_LIMIT=30

# Email (SMTP app password, not your account password)
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM=your_email@example.com
CONTACT_EMAIL=your_email@example.com
ADMIN_EMAIL=your_email@example.com
ALERT_EMAIL=your_email@example.com
TEST_RECIPIENT_EMAIL=your_email@example.com

# Newsletter API (for n8n automation)
NEWSLETTER_API_KEY=your_newsletter_api_key_here

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
