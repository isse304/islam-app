# Server environment variables
PORT=3000
NODE_ENV=production

# Domain Configuration
DOMAIN=nura-ai.app
EMAIL=your-email@domain.com

# Database
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/islamapp?retryWrites=true&w=majority
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password

# Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here

# AWS Configuration
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVEN_LABS_KEY=your_eleven_labs_key_here

# Firebase Admin (entire service account JSON on one line)
FIREBASE_CONFIG={"type":"service_account","project_id":"your_project_id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your_service_account_email"}

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=your_stripe_price_id_here

# Email (SMTP app password, not your account password)
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM=your_email@example.com
CONTACT_EMAIL=your_email@example.com
ADMIN_EMAIL=your_email@example.com

# Security
CORS_ORIGIN=https://nura-ai.app
SESSION_SECRET=your_long_random_session_secret_here

# SSL Configuration
SSL_KEY_PATH=/path/to/ssl/key.pem
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_CA_PATH=/path/to/ssl/ca.pem

# Newsletter API (for n8n automation)
NEWSLETTER_API_KEY=your_newsletter_api_key_here

# Logging
LOG_LEVEL=info
LOG_DIR=/path/to/logs 