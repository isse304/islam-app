# Server environment variables
PORT=3000
NODE_ENV=production

# Domain Configuration
DOMAIN=nura-ai.app
EMAIL=your-email@domain.com

# Database
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/islamapp?retryWrites=true&w=majority
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password

# Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here

# AWS Configuration
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVEN_LABS_KEY=your_eleven_labs_key_here

# Security
CORS_ORIGIN=https://nura-ai.app
SESSION_SECRET=your_long_random_session_secret_here

# SSL Configuration
SSL_KEY_PATH=/path/to/ssl/key.pem
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_CA_PATH=/path/to/ssl/ca.pem

# Newsletter API (for n8n automation)
NEWSLETTER_API_KEY=0595cb25738527a6ad82a5fb4bd8cbf625dc4737178f5fabe608fc3c0e613879

# Logging
LOG_LEVEL=info
LOG_DIR=/path/to/logs 