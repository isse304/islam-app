{
    "name": "islam-app-server",
    "version": "1.0.0",
    "description": "Backend server for IslamApp",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "start:dev": "cross-env NODE_ENV=development nodemon -r dotenv/config index.ts",
        "start:prod": "NODE_ENV=production node dist/index.js",
        "build": "tsc",
        "postinstall": "npm run build",
        "lint": "eslint . --ext .ts",
        "test": "jest",
        "ssl:setup": "node scripts/setup-ssl.js"
    },
    "dependencies": {
        "@clerk/backend": "^1.25.1",
        "@clerk/clerk-sdk-node": "^4.8.7",
        "@clerk/express": "^1.3.52",
        "@types/axios": "^0.14.4",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.17",
        "@types/express-rate-limit": "^6.0.2",
        "@types/express-session": "^1.18.1",
        "@types/node": "^18.15.11",
        "@types/nodemailer": "^6.4.17",
        "@types/winston": "^2.4.4",
        "axios": "^1.8.2",
        "build": "^0.1.4",
        "compression": "^1.7.4",
        "connect-mongo": "^5.1.0",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^6.7.0",
        "express-session": "^1.17.3",
        "greenlock-express": "^4.0.3",
        "helmet": "^7.0.0",
        "mongoose": "^7.0.3",
        "nodemailer": "^6.10.0",
        "openai": "^4.86.1",
        "run": "^1.5.0",
        "stripe": "^14.18.0",
        "typescript": "^5.0.3",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^5.57.1",
        "@typescript-eslint/parser": "^5.57.1",
        "eslint": "^8.37.0",
        "jest": "^29.5.0",
        "nodemon": "^2.0.22",
        "ts-node": "^10.9.1"
